{
  "manifest_version": 3,
  "name": "AI Bookmark Organizer",
  "version": "1.0.0",
  "description": "AI 智能书签整理 - 自动分类、去重、可回滚",
  "minimum_chrome_version": "114",
  "permissions": [
    "bookmarks",
    "storage",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "AI Bookmark Organizer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}