{
  "manifest_version": 3,
  "name": "AI Bookmark Organizer MVP",
  "version": "2.17.0",
  "description": "v2.17: 修复书签栏清理 - 使用实时数据正确检测空文件夹",
  "minimum_chrome_version": "114",
  "permissions": [
    "bookmarks",
    "storage",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "AI Bookmark Organizer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}